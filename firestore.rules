rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read and write for SDIT Al Fikri digital archives
    // Allows school admins and teachers to sync without sign-in barriers
    match /documents/{documentId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
